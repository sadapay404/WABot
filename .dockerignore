# Keep the build context small and, more importantly, keep secrets and
# session credentials out of the image layers.
.git
.gitignore
node_modules
npm-debug.log*

# Credentials and runtime state — never bake these into an image.
.env
.env.*
!.env.example
data
auth_info_baileys
*.nwb
*.pem
*.key

docs
test
deploy
README.md
Dockerfile
.dockerignore
docker-compose.yml
