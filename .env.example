# ══════════════════════════════════════════════════════════════════
#  Nexus-WA — environment configuration
#  Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# ══════════════════════════════════════════════════════════════════

# ── RUNTIME MODE ───────────────────────────────────────────────────
# dry-run : NO WhatsApp connection at all. Fake socket, real plugin
#           logic. This is the preview mode — zero ban risk.
# observe : connects to WhatsApp (use a BURNER number), reads + logs
#           to Telegram, outbound to non-owners is HARD BLOCKED.
# live    : full bot. Only after observe mode has been validated.
NEXUS_MODE=dry-run

# ── GENERAL ────────────────────────────────────────────────────────
NEXUS_PREFIX=.
LOG_LEVEL=info
TZ=UTC
# Legacy timezone used by other date helpers. .schedule/.remind use SCHEDULE_TIMEZONE below.

# ── WHATSAPP ───────────────────────────────────────────────────────
# Pairing code mode: digits only, no +, no spaces, with country code.
# e.g. 15551234567   (leave empty to use QR code instead)
WA_PAIRING_NUMBER=
WA_SESSION_DIR=./data/auth
WA_BOT_NAME=Nexus-WA
# Standard companion profile (default): web.
# For a FRESH WhatsApp Business companion only, set smb_android. It registers
# as SMB_ANDROID + webInfo + CHROME pairing ID, with Android Phone DeviceProps.
# Never point this at an existing auth directory; use a new WA_SESSION_DIR so
# the current linked session stays untouched. See docs/TERMUX.md.
WA_COMPANION_PROFILE=web
# Label recorded against this number in the dashboard and /sessions.
# Use 'burner' while testing, 'primary' once this is your real number.
WA_ROLE=burner

# ── SAFETY SHIELD ──────────────────────────────────────────────────
# Comma-separated list of WhatsApp JIDs allowed to run owner commands.
# Group JIDs look like 120363025246125888@g.us, DMs like 15551234567@s.whatsapp.net
#
# Leave EMPTY and the whitelist fails closed: NOBODY can run owner commands,
# and live mode refuses to start. To find your own JID, start in observe mode
# and send the bot a message — it logs your JID to the Telegram panel.
# (There is no auto-learn; that would let a stranger become owner by racing you.)
OWNER_JIDS=
# Where view-once / edit / delete alerts are sent. If blank, the first owner
# other than the linked account is used; if there is no such owner, alerts go
# to the linked account's own chat.
CAPTURE_ALERT_JID=
# Max outbound messages per chat within RATE_LIMIT_WINDOW_MS.
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_WINDOW_MS=60000
# Block the 5th similar text/caption send to one chat inside 60 seconds.
# Similar means normalized exact text or >=80% token overlap (3+ tokens).
# The queue halts and alerts the owner; fix the source before .panic resume.
OUTBOUND_LOOP_THRESHOLD=5
OUTBOUND_LOOP_WINDOW_MS=60000
# Alert once per window after 30 successful sends across all chats. Does not halt.
OUTBOUND_VOLUME_LIMIT=30
OUTBOUND_VOLUME_WINDOW_MS=60000
# How many sends run at once. Keep at 1 — serial sending is the single
# biggest anti-pattern-detection win you get.
QUEUE_CONCURRENCY=1
# Simulate presence + typing before replying.
TYPING_INDICATOR=true
# In observe mode, still allow replying to the owner (so you can test).
OBSERVE_ALLOW_REPLY_TO_OWNER=true

# ── TELEGRAM CONTROL PANEL ─────────────────────────────────────────
# Create via @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot)
TELEGRAM_OWNER_ID=

# ── WEB DASHBOARD ──────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
# REQUIRED in observe/live — the page shows real numbers and contact names,
# and the server refuses to start without it. Ignored in dry-run.
# Generate one with:  openssl rand -hex 24
DASHBOARD_TOKEN=
# Seed synthetic sessions/contacts so the UI can be evaluated before any
# account is linked. Only ever applies in dry-run.
DASHBOARD_SEED_DEMO=true
# Which interface the container port is published on (docker compose only).
# 127.0.0.1 = reachable only on the host, use a tunnel to get in from outside.
# 0.0.0.0   = anyone on your LAN can reach it. Only set this for LAN access.
DASHBOARD_BIND=127.0.0.1

# ── SCHEDULER ──────────────────────────────────────────────────────
# How often due jobs are polled. 15s lands reminders within a few seconds of
# their target while barely touching the disk.
SCHEDULER_TICK_MS=15000
# Cap per tick, so a backlog built up during downtime cannot burst-spam a chat.
SCHEDULER_MAX_PER_TICK=25
# Timezone for natural-language .schedule/.remind dates. Existing jobs are
# absolute timestamps and will not shift if this value is changed later.
SCHEDULE_TIMEZONE=Asia/Karachi

# ── REMOTE VAULT (only needed on hosts with an ephemeral disk) ─────
# Free PaaS tiers wipe data/auth on every restart, which would force you to
# re-pair constantly. This pushes an AES-256-GCM encrypted snapshot of your
# session + database to a store you control, and restores it on boot.
# The remote only ever sees ciphertext it cannot decrypt.
#
# Leave all blank on a VPS or a home machine — you do not need it there.
#
#   REMOTE_VAULT_KIND  github | http
#   REMOTE_VAULT_URL   a private GitHub repo, or any endpoint taking PUT/GET
#   REMOTE_VAULT_TOKEN GitHub fine-grained PAT: Contents read+write, ONE repo
REMOTE_VAULT_KIND=github
REMOTE_VAULT_URL=
REMOTE_VAULT_TOKEN=
# Must be >= 8 characters and must be the SAME every time, or the backup you
# pushed cannot be decrypted on the next boot. Do not lose this.
REMOTE_VAULT_PASSPHRASE=
REMOTE_VAULT_PATH=nexus-backup.nwb
REMOTE_VAULT_INTERVAL_MIN=30

# ── STORAGE ────────────────────────────────────────────────────────
DB_PATH=./data/nexus.db

# ── AI (Phase 3 — safe to leave blank for now) ─────────────────────
# Providers in priority order (lower number = tried first). If one fails,
# the next is tried. Only providers with a key below are used.
AI_PROVIDERS=gemini:1,groq:2,openrouter:3,openai:4
# OpenRouter uses the free router model openrouter/free (fixed, no model choice needed).
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=
AI_MAX_HISTORY=12
# Public `.ai` limits (the owner is exempt from the cooldown).
AI_SENDER_COOLDOWN_SEC=15
AI_DAILY_LIMIT=200
# Max transcript characters sent to an AI by `.ask` (4,000–100,000).
AI_ASK_MAX_CHARS=60000
