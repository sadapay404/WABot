#!/data/data/com.termux/files/usr/bin/bash
#
# nexus — control the bot on this phone.
#
#   nexus start     start in the background (restarts itself if it crashes)
#   nexus stop      stop it
#   nexus restart   stop, then start
#   nexus status    is it running, linked, how much memory
#   nexus logs      follow the log (Ctrl-C to stop watching)
#   nexus pair [number]   link a WhatsApp account and make it the owner
#   nexus pair remove     delete everything about previous pairs
#
set -uo pipefail

APP_DIR="$HOME/nexus-wa"
DATA_DIR="$HOME/.nexus-wa"
LOG_DIR="$DATA_DIR/logs"
LOG="$LOG_DIR/nexus.log"
PIDFILE="$DATA_DIR/nexus.pid"
BOTPIDFILE="$DATA_DIR/nexus.bot.pid"
NODE_FLAGS="--disable-warning=ExperimentalWarning"

mkdir -p "$LOG_DIR"

c() { printf '\033[%sm%s\033[0m' "$1" "$2"; }

# Trim the log before it eats the phone's storage. Termux has no logrotate.
rotate_log() {
  [ -f "$LOG" ] || return 0
  local size
  size=$(wc -c <"$LOG" 2>/dev/null || echo 0)
  if [ "$size" -gt 5242880 ]; then   # 5 MB
    tail -c 1048576 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
  return 1
}

start() {
  local pid
  if pid=$(running_pid); then
    echo "$(c '33' '•') already running (pid $pid)"
    return 0
  fi
  [ -f "$APP_DIR/src/index.js" ] || { echo "$(c '31' '✗') $APP_DIR not found — run setup.sh first"; exit 1; }
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — copy .env.example and edit it"; exit 1; }

  # Keep the CPU awake. Without this Android dozes the process and WhatsApp
  # silently drops off. Harmless if termux-api is absent.
  command -v termux-wake-lock >/dev/null && termux-wake-lock 2>/dev/null \
    || echo "$(c '33' '!') termux-wake-lock unavailable — install termux-api"

  rotate_log
  cd "$APP_DIR" || exit 1

  # Detached supervisor. It restarts the bot if it ever exits, with a pause
  # that grows so a crash-loop cannot hammer WhatsApp's servers.
  #
  # PIDs are tracked in files, NOT found with pgrep/pkill. A pattern like
  # "nexus-wa/src/index.js" also matches this supervisor's own bash -c text
  # and any shell whose command line merely mentions the path — pkill on that
  # kills the wrong things. Recording the child PID is exact.
  nohup bash -c '
    APP_DIR="'"$APP_DIR"'"; PIDFILE="'"$PIDFILE"'"
    BOTPID="'"$BOTPIDFILE"'"; LOG="'"$LOG"'"
    echo $$ > "$PIDFILE"
    trap "rm -f \"$BOTPID\"" EXIT
    attempt=0
    while :; do
      printf "\n===== start %s (attempt %d) =====\n" "$(date "+%F %T")" "$attempt" >>"$LOG"
      node '"$NODE_FLAGS"' "$APP_DIR/src/index.js" --serve >>"$LOG" 2>&1 &
      node_pid=$!
      echo "$node_pid" > "$BOTPID"
      wait "$node_pid"
      code=$?
      rm -f "$BOTPID"
      printf "===== exited %d at %s =====\n" "$code" "$(date "+%F %T")" >>"$LOG"
      [ "$code" -eq 0 ] && break
      attempt=$((attempt+1))
      delay=$(( 5 * attempt )); [ "$delay" -gt 60 ] && delay=60
      sleep "$delay"
    done
  ' >/dev/null 2>&1 &

  sleep 2
  if pid=$(running_pid); then
    echo "$(c '32' '✓') started (pid $pid)"
    echo "  watch it:   nexus logs"
    echo "  pairing:    nexus pair"
  else
    echo "$(c '31' '✗') failed to start — see: nexus logs"
    exit 1
  fi
}

stop() {
  local pid
  if ! pid=$(running_pid); then
    echo "$(c '33' '•') not running"
    rm -f "$PIDFILE"
    return 0
  fi
  local bot
  bot=$(cat "$BOTPIDFILE" 2>/dev/null)
  echo "$(c '33' '·') stopping $pid…"
  # Supervisor first, so it does not restart the bot we are about to stop.
  kill -TERM "$pid" 2>/dev/null
  # SIGTERM lets the bot flush its backup and close the socket cleanly.
  [ -n "$bot" ] && kill -TERM "$bot" 2>/dev/null
  for _ in $(seq 1 10); do
    running_pid >/dev/null || break
    sleep 1
  done
  if running_pid >/dev/null; then
    echo "$(c '33' '!') still up — forcing"
    kill -KILL "$pid" 2>/dev/null
    [ -n "$bot" ] && kill -KILL "$bot" 2>/dev/null
  fi
  rm -f "$PIDFILE" "$BOTPIDFILE"
  echo "$(c '32' '✓') stopped"
}

status() {
  local pid
  if pid=$(running_pid); then
    echo "$(c '32' '✓') running (pid $pid)"
    local bot rss
    bot=$(cat "$BOTPIDFILE" 2>/dev/null)
    if [ -n "$bot" ] && kill -0 "$bot" 2>/dev/null; then
      # Memory matters on a phone: Android kills the biggest process first.
      rss=$(ps -o rss= -p "$bot" 2>/dev/null | tr -d ' ')
      [ -n "$rss" ] && printf '  bot:    pid %s · %.1f MB\n' "$bot" "$(awk "BEGIN{print $rss/1024}")"
    else
      echo "  bot:    $(c '33' 'supervisor up but the bot is not — check nexus logs')"
    fi
  else
    echo "$(c '31' '✗') not running"
  fi
  [ -f "$DATA_DIR/nexus.db" ] && printf '  db:     %s\n' "$(du -h "$DATA_DIR/nexus.db" | cut -f1)"
  session_report
  command -v termux-battery-status >/dev/null && termux-battery-status 2>/dev/null \
    | tr -d '{}",' | grep -E 'percentage|plugged|status' | sed 's/^/  battery: /'
}

# Where the bot keeps its WhatsApp session, from .env (relative paths are
# relative to the app folder, as the bot itself resolves them).
session_dir() {
  local d
  d=$(grep -E '^WA_SESSION_DIR=' "$APP_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
  d="${d:-./data/auth}"
  case "$d" in /*) ;; *) d="$APP_DIR/$d" ;; esac
  printf '%s\n' "$d"
}

# Who is linked, and whether that account can run owner commands.
session_report() {
  local sdir creds me lid lid_num owners
  sdir=$(session_dir)
  creds="$sdir/creds.json"
  if [ ! -f "$creds" ]; then
    echo "  session: $(c '33' 'not paired yet') (no $creds)"
    return 0
  fi
  me=$(grep -o '"id":"[^"]*@s.whatsapp.net"' "$creds" | head -1 | cut -d'"' -f4)
  lid=$(grep -o '"lid":"[^"]*@lid"' "$creds" | head -1 | cut -d'"' -f4)
  echo "  session: linked as ${me:-unknown} (${sdir})"
  if [ -z "$lid" ]; then
    echo "  LID:     $(c '33' 'not known yet — wait a minute after linking, then run nexus status')"
    return 0
  fi
  echo "  LID:     $lid"
  owners=$(grep -E '^OWNER_JIDS=' "$APP_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
  lid_num="${lid%@lid}"; lid_num="${lid_num%%:*}"
  if printf '%s' "$owners" | grep -q "$lid_num"; then
    echo "  owner:   $(c '32' 'LID is in OWNER_JIDS — commands from You chat work')"
  else
    echo "  owner:   $(c '33' 'LID is NOT in OWNER_JIDS — add it, then nexus restart:')"
    echo "           OWNER_JIDS=...,${lid_num}@lid"
  fi
}

logs() { tail -f "$LOG"; }

creds_file() { printf '%s\n' "$(session_dir)/creds.json"; }

# The phone number this session is linked to (empty if not linked).
linked_number() {
  local f
  f=$(creds_file)
  [ -f "$f" ] || return 0
  grep -o '"id":"[^"]*@s.whatsapp.net"' "$f" | head -1 | cut -d'"' -f4 | cut -d: -f1 | cut -d@ -f1
}

# The account's LID (empty until the bot has connected once after linking).
linked_lid() {
  local f
  f=$(creds_file)
  [ -f "$f" ] || return 0
  grep -o '"lid":"[^"]*@lid"' "$f" | head -1 | cut -d'"' -f4 | cut -d: -f1 | cut -d@ -f1
}

# Set KEY=VALUE in the app's .env, replacing the line if it exists.
set_env() {
  local key="$1" val="$2" f="$APP_DIR/.env"
  if grep -q "^${key}=" "$f"; then
    awk -v k="$key" -v v="$val" 'BEGIN{FS="="} $1==k {print k "=" v; next} {print}' "$f" >"$f.tmp" \
      && mv "$f.tmp" "$f"
  else
    printf '%s=%s\n' "$key" "$val" >>"$f"
  fi
}

# nexus pair remove [--yes]
# Deletes every trace of previous pairings: sessions, database, backups, old .env copies.
pair_remove() {
  local yes=0 arg answer ts
  for arg in "$@"; do
    case "$arg" in --yes|-y) yes=1 ;; esac
  done
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — run setup.sh first"; exit 1; }

  if [ "$yes" -ne 1 ]; then
    echo "This deletes EVERYTHING about previous pairs:"
    echo "  • every WhatsApp session (all linked accounts)"
    echo "  • the database: contacts, scheduled jobs, notes, message history"
    echo "  • local backups and old .env copies"
    echo "  • the pairing number and owner in .env"
    echo "The bot code and the logs are kept. This cannot be undone."
    read -r -p "Type REMOVE to continue: " answer
    [ "$answer" = "REMOVE" ] || { echo "cancelled"; exit 0; }
  fi

  echo "$(c '33' '·') stopping the bot"
  stop >/dev/null 2>&1
  ts=$(date +%Y%m%d-%H%M%S)

  rm -rf "$DATA_DIR"/auth "$DATA_DIR"/auth-* \
    "$DATA_DIR"/nexus.db "$DATA_DIR"/nexus.db-wal "$DATA_DIR"/nexus.db-shm "$DATA_DIR"/nexus.db.old-* \
    "$DATA_DIR"/backups "$APP_DIR"/.env.bak-*

  set_env WA_PAIRING_NUMBER ""
  set_env OWNER_JIDS ""
  set_env WA_SESSION_DIR "$DATA_DIR/auth"
  # A remote vault restores the old session on boot when local data is empty.
  # Pointing it at a new file name stops that.
  set_env REMOTE_VAULT_PATH "nexus-backup-removed-$ts.nwb"

  echo "$(c '32' '✓') removed. Next: nexus pair"
  echo "  If you use the remote vault, also delete the old backup file in its GitHub repo."
}

# nexus pair [number] [--yes]   (also accepts: nexus pair --new [number])
# Links a WhatsApp account and makes it the owner, with no IDs to copy by hand.
pair_link() {
  local number="" yes=0 arg answer linked lid owners i code offset
  for arg in "$@"; do
    case "$arg" in
      --new) ;;
      --yes|-y) yes=1 ;;
      *) [ -z "$number" ] && number="$arg" ;;
    esac
  done
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — run setup.sh first"; exit 1; }

  linked=$(linked_number)
  if [ -n "$linked" ]; then
    echo "$(c '33' '!') already linked to $linked."
    echo "  To link a different account, first run: nexus pair remove"
    exit 1
  fi

  if [ -z "$number" ]; then
    read -r -p "WhatsApp number to link (country code, no +, e.g. 923001234567): " number
  fi
  number=$(printf '%s' "$number" | tr -cd '0-9')
  if ! [[ "$number" =~ ^[0-9]{8,15}$ ]]; then
    echo "$(c '31' '✗') not a valid number — digits with country code only"
    exit 1
  fi

  if [ "$yes" -ne 1 ]; then
    read -r -p "Link WhatsApp $number and make it the owner? [y/N] " answer
    case "$answer" in y|Y|yes|YES) ;; *) echo "cancelled"; exit 0 ;; esac
  fi

  stop >/dev/null 2>&1
  # Nothing is linked at this point, so leftovers from an unfinished try are safe to clear.
  rm -rf "$DATA_DIR/auth"
  mkdir -p "$DATA_DIR/auth"

  set_env WA_PAIRING_NUMBER "$number"
  set_env WA_SESSION_DIR "$DATA_DIR/auth"
  set_env WA_COMPANION_PROFILE "web"
  set_env REMOTE_VAULT_PATH "nexus-backup-$number.nwb"
  set_env OWNER_JIDS "${number}@s.whatsapp.net"

  offset=0
  [ -f "$LOG" ] && offset=$(wc -c <"$LOG")
  start || exit 1

  code=""
  for i in $(seq 1 60); do
    code=$(tail -c +"$((offset + 1))" "$LOG" 2>/dev/null | grep -a "pairing code:" | tail -1)
    [ -n "$code" ] && break
    sleep 2
  done
  if [ -n "$code" ]; then
    echo "$(c '32' '✓') $code"
  else
    echo "$(c '33' '!') no code yet — check: nexus logs"
  fi
  cat <<EOF

On the phone with $number:
  Settings → Linked devices → Link a device → Link with phone number instead
  and enter the code above.

Waiting up to 10 minutes for the link…
EOF

  linked=""
  for i in $(seq 1 200); do
    linked=$(linked_number)
    [ -n "$linked" ] && break
    sleep 3
  done
  if [ -z "$linked" ]; then
    echo "$(c '33' '!') not linked yet. Check: nexus status   or   nexus logs"
    exit 1
  fi
  echo "$(c '32' '✓') linked as $linked"

  # The LID is saved once the bot has connected. Wait for it so commands from
  # the "You" chat are recognised without any manual step.
  lid=""
  for i in $(seq 1 20); do
    lid=$(linked_lid)
    [ -n "$lid" ] && break
    sleep 3
  done
  owners="${linked}@s.whatsapp.net"
  [ -n "$lid" ] && owners="$owners,${lid}@lid"
  set_env OWNER_JIDS "$owners"
  echo "$(c '32' '✓') owner set: $owners"

  echo "$(c '33' '·') restarting so the owner takes effect"
  stop >/dev/null 2>&1
  start || exit 1

  if [ -z "$lid" ]; then
    echo "$(c '33' '!') LID not seen yet. Wait a minute, then run: nexus restart"
  fi
  cat <<EOF

Done. Send .ping in the "You" chat to test.
Mode is $(grep -E '^NEXUS_MODE=' "$APP_DIR/.env" | tail -1 | cut -d= -f2-) (set NEXUS_MODE=live in .env when you are ready).
EOF
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  status)  status ;;
  logs)    logs ;;
  pair)
    case "${2:-}" in
      remove) pair_remove "${@:3}" ;;
      *)      pair_link "${@:2}" ;;
    esac ;;
  harden)  exec bash "$APP_DIR/deploy/termux/harden.sh" "${2:-}" ;;
  *)
    cat <<EOF
nexus — control Nexus-WA on this phone

  nexus start     start in the background
  nexus stop      stop
  nexus restart   restart
  nexus status    running? linked? memory? battery?
  nexus logs      follow the log
  nexus pair [number]   link a WhatsApp account (asks for the number)
  nexus pair remove     delete everything about previous pairs
  nexus harden    stop Android killing the bot (needs Shizuku)
  nexus harden --check   report what is in place, change nothing
EOF
    ;;
esac
