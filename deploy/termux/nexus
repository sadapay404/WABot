#!/data/data/com.termux/files/usr/bin/bash
#
# nexus — control the bot on this phone.
#
#   nexus start     start in the background (restarts itself if it crashes)
#   nexus stop      stop it
#   nexus restart   stop, then start
#   nexus update    fetch the latest from GitHub, install it, restart
#   nexus ensure    start the bot only if it should run and is not (used by boot + watchdog)
#   nexus doctor    why the bot may not be running, and what to check
#   nexus watchdog on|off|status   15-minute Android job that revives the bot
#   nexus status    is it running, linked, how much memory
#   nexus logs      follow the log (Ctrl-C to stop watching)
#   nexus pair [number]   link a WhatsApp account and make it the owner
#   nexus pair remove     delete everything about previous pairs
#
set -uo pipefail

APP_DIR="$HOME/nexus-wa"
DATA_DIR="$HOME/.nexus-wa"
LOG_DIR="$DATA_DIR/logs"
LOG="$LOG_DIR/nexus.log"
PIDFILE="$DATA_DIR/nexus.pid"
BOTPIDFILE="$DATA_DIR/nexus.bot.pid"
NODE_FLAGS="--disable-warning=ExperimentalWarning"
# Written by `nexus stop`, removed by `nexus start`. While it exists, nothing
# (boot hook, watchdog, supervisor) starts the bot again.
STOPFILE="$DATA_DIR/nexus.stopped"
# Written by the bot every 30s while it runs. ensure reads it to catch a bot
# that is alive but wedged (it would otherwise keep its PID forever).
HEARTBEAT="$DATA_DIR/heartbeat"
WATCHDOG_JOB=4242
WATCHDOG_SCRIPT="$APP_DIR/deploy/termux/watchdog.sh"

mkdir -p "$LOG_DIR"

c() { printf '\033[%sm%s\033[0m' "$1" "$2"; }

# Trim the log before it eats the phone's storage. Termux has no logrotate.
rotate_log() {
  [ -f "$LOG" ] || return 0
  local size
  size=$(wc -c <"$LOG" 2>/dev/null || echo 0)
  if [ "$size" -gt 5242880 ]; then   # 5 MB
    tail -c 1048576 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

running_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid
  pid=$(cat "$PIDFILE" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { echo "$pid"; return 0; }
  return 1
}

start() {
  local pid
  rm -f "$STOPFILE"
  if pid=$(running_pid); then
    echo "$(c '33' '•') already running (pid $pid)"
    return 0
  fi
  [ -f "$APP_DIR/src/index.js" ] || { echo "$(c '31' '✗') $APP_DIR not found — run setup.sh first"; exit 1; }
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — copy .env.example and edit it"; exit 1; }

  # Keep the CPU awake. Without this Android dozes the process and WhatsApp
  # silently drops off. Harmless if termux-api is absent.
  command -v termux-wake-lock >/dev/null && termux-wake-lock 2>/dev/null \
    || echo "$(c '33' '!') termux-wake-lock unavailable — install termux-api"

  rotate_log
  cd "$APP_DIR" || exit 1

  # Detached supervisor. It restarts the bot after ANY exit, except:
  #   • `nexus stop` wrote STOPFILE (a deliberate stop), or
  #   • the bot exits with code 3 (session taken over, or unlinked: needs a human).
  # The pause grows 5s, 10s, … up to 60s, and resets after a run of 10+ minutes.
  #
  # PIDs are tracked in files, NOT found with pgrep/pkill. A pattern like
  # "nexus-wa/src/index.js" also matches this supervisor's own bash -c text
  # and any shell whose command line merely mentions the path — pkill on that
  # kills the wrong things. Recording the child PID is exact.
  local detach="nohup"
  command -v setsid >/dev/null 2>&1 && detach="setsid nohup"
  rm -f "$STOPFILE" "$HEARTBEAT"
  $detach bash -c '
    APP_DIR="'"$APP_DIR"'"; PIDFILE="'"$PIDFILE"'"; STOPFILE="'"$STOPFILE"'"
    BOTPID="'"$BOTPIDFILE"'"; LOG="'"$LOG"'"
    echo $$ > "$PIDFILE"
    trap "rm -f \"$BOTPID\"" EXIT
    attempt=0
    while :; do
      started=$(date +%s)
      printf "\n===== start %s (attempt %d) =====\n" "$(date "+%F %T")" "$attempt" >>"$LOG"
      NEXUS_HEARTBEAT_FILE="'"$HEARTBEAT"'" node '"$NODE_FLAGS"' "$APP_DIR/src/index.js" --serve >>"$LOG" 2>&1 &
      node_pid=$!
      echo "$node_pid" > "$BOTPID"
      wait "$node_pid"
      code=$?
      rm -f "$BOTPID"
      printf "===== exited %d at %s =====\n" "$code" "$(date "+%F %T")" >>"$LOG"
      [ -f "$STOPFILE" ] && break
      if [ "$code" -eq 3 ]; then
        # Sticky: the watchdog and boot hook must not keep reconnecting and
        # fighting the other device. Only `nexus start` clears this.
        echo "the bot stopped itself (exit 3: session taken over, or unlinked)" >"$STOPFILE"
        printf "bot will not restart by itself (exit 3: session taken over or unlinked). See: nexus doctor\n" >>"$LOG"
        break
      fi
      [ $(( $(date +%s) - started )) -ge 600 ] && attempt=0
      attempt=$((attempt+1))
      delay=$(( 5 * attempt )); [ "$delay" -gt 60 ] && delay=60
      sleep "$delay"
    done
  ' >/dev/null 2>&1 &

  sleep 2
  if pid=$(running_pid); then
    echo "$(c '32' '✓') started (pid $pid)"
    echo "  watch it:   nexus logs"
    echo "  pairing:    nexus pair"
    schedule_watchdog >/dev/null 2>&1 || true
  else
    echo "$(c '31' '✗') failed to start — see: nexus logs"
    exit 1
  fi
}

stop() {
  local pid
  # Record the intent first, so nothing restarts the bot while it shuts down.
  : >"$STOPFILE"
  if ! pid=$(running_pid); then
    echo "$(c '33' '•') not running"
    rm -f "$PIDFILE"
    return 0
  fi
  local bot
  bot=$(cat "$BOTPIDFILE" 2>/dev/null)
  echo "$(c '33' '·') stopping $pid…"
  # Supervisor first, so it does not restart the bot we are about to stop.
  kill -TERM "$pid" 2>/dev/null
  # SIGTERM lets the bot flush its backup and close the socket cleanly.
  [ -n "$bot" ] && kill -TERM "$bot" 2>/dev/null
  for _ in $(seq 1 10); do
    running_pid >/dev/null || break
    sleep 1
  done
  if running_pid >/dev/null; then
    echo "$(c '33' '!') still up — forcing"
    kill -KILL "$pid" 2>/dev/null
    [ -n "$bot" ] && kill -KILL "$bot" 2>/dev/null
  fi
  rm -f "$PIDFILE" "$BOTPIDFILE"
  echo "$(c '32' '✓') stopped"
}

status() {
  local pid
  if [ -f "$STOPFILE" ] && ! running_pid >/dev/null; then
    echo "$(c '33' '•') $(stop_reason). Start it with: nexus start"
    return 0
  fi
  if pid=$(running_pid); then
    echo "$(c '32' '✓') running (pid $pid)"
    local bot rss
    bot=$(cat "$BOTPIDFILE" 2>/dev/null)
    if [ -n "$bot" ] && kill -0 "$bot" 2>/dev/null; then
      # Memory matters on a phone: Android kills the biggest process first.
      rss=$(ps -o rss= -p "$bot" 2>/dev/null | tr -d ' ')
      [ -n "$rss" ] && printf '  bot:    pid %s · %.1f MB\n' "$bot" "$(awk "BEGIN{print $rss/1024}")"
    else
      echo "  bot:    $(c '33' 'supervisor up but the bot is not — check nexus logs')"
    fi
  else
    echo "$(c '31' '✗') not running"
  fi
  [ -f "$DATA_DIR/nexus.db" ] && printf '  db:     %s\n' "$(du -h "$DATA_DIR/nexus.db" | cut -f1)"
  session_report
  command -v termux-battery-status >/dev/null && termux-battery-status 2>/dev/null \
    | tr -d '{}",' | grep -E 'percentage|plugged|status' | sed 's/^/  battery: /'
}

# Where the bot keeps its WhatsApp session, from .env (relative paths are
# relative to the app folder, as the bot itself resolves them).
session_dir() {
  local d
  d=$(grep -E '^WA_SESSION_DIR=' "$APP_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
  d="${d:-./data/auth}"
  case "$d" in /*) ;; *) d="$APP_DIR/$d" ;; esac
  printf '%s\n' "$d"
}

# Who is linked, and whether that account can run owner commands.
session_report() {
  local sdir creds me lid lid_num owners
  sdir=$(session_dir)
  creds="$sdir/creds.json"
  if [ ! -f "$creds" ]; then
    echo "  session: $(c '33' 'not paired yet') (no $creds)"
    return 0
  fi
  me=$(grep -o '"id":"[^"]*@s.whatsapp.net"' "$creds" | head -1 | cut -d'"' -f4)
  lid=$(grep -o '"lid":"[^"]*@lid"' "$creds" | head -1 | cut -d'"' -f4)
  echo "  session: linked as ${me:-unknown} (${sdir})"
  if [ -z "$lid" ]; then
    echo "  LID:     $(c '33' 'not known yet — wait a minute after linking, then run nexus status')"
    return 0
  fi
  echo "  LID:     $lid"
  owners=$(grep -E '^OWNER_JIDS=' "$APP_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2-)
  lid_num="${lid%@lid}"; lid_num="${lid_num%%:*}"
  if printf '%s' "$owners" | grep -q "$lid_num"; then
    echo "  owner:   $(c '32' 'LID is in OWNER_JIDS — commands from You chat work')"
  else
    echo "  owner:   $(c '33' 'LID is NOT in OWNER_JIDS — add it, then nexus restart:')"
    echo "           OWNER_JIDS=...,${lid_num}@lid"
  fi
}

logs() { tail -f "$LOG"; }

creds_file() { printf '%s\n' "$(session_dir)/creds.json"; }

# The phone number this session is linked to (empty if not linked).
linked_number() {
  local f
  f=$(creds_file)
  [ -f "$f" ] || return 0
  grep -o '"id":"[^"]*@s.whatsapp.net"' "$f" | head -1 | cut -d'"' -f4 | cut -d: -f1 | cut -d@ -f1
}

# The account's LID (empty until the bot has connected once after linking).
linked_lid() {
  local f
  f=$(creds_file)
  [ -f "$f" ] || return 0
  grep -o '"lid":"[^"]*@lid"' "$f" | head -1 | cut -d'"' -f4 | cut -d: -f1 | cut -d@ -f1
}

# Set KEY=VALUE in the app's .env, replacing the line if it exists.
set_env() {
  local key="$1" val="$2" f="$APP_DIR/.env"
  if grep -q "^${key}=" "$f"; then
    awk -v k="$key" -v v="$val" 'BEGIN{FS="="} $1==k {print k "=" v; next} {print}' "$f" >"$f.tmp" \
      && mv "$f.tmp" "$f"
  else
    printf '%s=%s\n' "$key" "$val" >>"$f"
  fi
}

# nexus pair remove [--yes]
# Deletes every trace of previous pairings: sessions, database, backups, old .env copies.
pair_remove() {
  local yes=0 arg answer ts
  for arg in "$@"; do
    case "$arg" in --yes|-y) yes=1 ;; esac
  done
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — run setup.sh first"; exit 1; }

  if [ "$yes" -ne 1 ]; then
    echo "This deletes EVERYTHING about previous pairs:"
    echo "  • every WhatsApp session (all linked accounts)"
    echo "  • the database: contacts, scheduled jobs, notes, message history"
    echo "  • local backups and old .env copies"
    echo "  • the pairing number and owner in .env"
    echo "The bot code and the logs are kept. This cannot be undone."
    read -r -p "Type REMOVE to continue: " answer
    [ "$answer" = "REMOVE" ] || { echo "cancelled"; exit 0; }
  fi

  echo "$(c '33' '·') stopping the bot"
  stop >/dev/null 2>&1
  ts=$(date +%Y%m%d-%H%M%S)

  rm -rf "$DATA_DIR"/auth "$DATA_DIR"/auth-* \
    "$DATA_DIR"/nexus.db "$DATA_DIR"/nexus.db-wal "$DATA_DIR"/nexus.db-shm "$DATA_DIR"/nexus.db.old-* \
    "$DATA_DIR"/backups "$APP_DIR"/.env.bak-*

  set_env WA_PAIRING_NUMBER ""
  set_env OWNER_JIDS ""
  set_env WA_SESSION_DIR "$DATA_DIR/auth"
  # A remote vault restores the old session on boot when local data is empty.
  # Pointing it at a new file name stops that.
  set_env REMOTE_VAULT_PATH "nexus-backup-removed-$ts.nwb"

  echo "$(c '32' '✓') removed. Next: nexus pair"
  echo "  If you use the remote vault, also delete the old backup file in its GitHub repo."
}

# nexus pair [number] [--yes]   (also accepts: nexus pair --new [number])
# Links a WhatsApp account and makes it the owner, with no IDs to copy by hand.
pair_link() {
  local number="" yes=0 arg answer linked lid owners i code offset
  for arg in "$@"; do
    case "$arg" in
      --new) ;;
      --yes|-y) yes=1 ;;
      *) [ -z "$number" ] && number="$arg" ;;
    esac
  done
  [ -f "$APP_DIR/.env" ] || { echo "$(c '31' '✗') no .env in $APP_DIR — run setup.sh first"; exit 1; }

  linked=$(linked_number)
  if [ -n "$linked" ]; then
    echo "$(c '33' '!') already linked to $linked."
    echo "  To link a different account, first run: nexus pair remove"
    exit 1
  fi

  if [ -z "$number" ]; then
    read -r -p "WhatsApp number to link (country code, no +, e.g. 923001234567): " number
  fi
  number=$(printf '%s' "$number" | tr -cd '0-9')
  if ! [[ "$number" =~ ^[0-9]{8,15}$ ]]; then
    echo "$(c '31' '✗') not a valid number — digits with country code only"
    exit 1
  fi

  if [ "$yes" -ne 1 ]; then
    read -r -p "Link WhatsApp $number and make it the owner? [y/N] " answer
    case "$answer" in y|Y|yes|YES) ;; *) echo "cancelled"; exit 0 ;; esac
  fi

  stop >/dev/null 2>&1
  # Nothing is linked at this point, so leftovers from an unfinished try are safe to clear.
  rm -rf "$DATA_DIR/auth"
  mkdir -p "$DATA_DIR/auth"

  set_env WA_PAIRING_NUMBER "$number"
  set_env WA_SESSION_DIR "$DATA_DIR/auth"
  set_env WA_COMPANION_PROFILE "web"
  set_env REMOTE_VAULT_PATH "nexus-backup-$number.nwb"
  set_env OWNER_JIDS "${number}@s.whatsapp.net"

  offset=0
  [ -f "$LOG" ] && offset=$(wc -c <"$LOG")
  start || exit 1

  code=""
  for i in $(seq 1 60); do
    code=$(tail -c +"$((offset + 1))" "$LOG" 2>/dev/null | grep -a "pairing code:" | tail -1)
    [ -n "$code" ] && break
    sleep 2
  done
  if [ -n "$code" ]; then
    echo "$(c '32' '✓') $code"
  else
    echo "$(c '33' '!') no code yet — check: nexus logs"
  fi
  cat <<EOF

On the phone with $number:
  Settings → Linked devices → Link a device → Link with phone number instead
  and enter the code above.

Waiting up to 10 minutes for the link…
EOF

  linked=""
  for i in $(seq 1 200); do
    linked=$(linked_number)
    [ -n "$linked" ] && break
    sleep 3
  done
  if [ -z "$linked" ]; then
    echo "$(c '33' '!') not linked yet. Check: nexus status   or   nexus logs"
    exit 1
  fi
  echo "$(c '32' '✓') linked as $linked"

  # The LID is saved once the bot has connected. Wait for it so commands from
  # the "You" chat are recognised without any manual step.
  lid=""
  for i in $(seq 1 20); do
    lid=$(linked_lid)
    [ -n "$lid" ] && break
    sleep 3
  done
  owners="${linked}@s.whatsapp.net"
  [ -n "$lid" ] && owners="$owners,${lid}@lid"
  set_env OWNER_JIDS "$owners"
  echo "$(c '32' '✓') owner set: $owners"

  echo "$(c '33' '·') restarting so the owner takes effect"
  stop >/dev/null 2>&1
  start || exit 1

  if [ -z "$lid" ]; then
    echo "$(c '33' '!') LID not seen yet. Wait a minute, then run: nexus restart"
  fi
  cat <<EOF

Done. Send .ping in the "You" chat to test.
Mode is $(grep -E '^NEXUS_MODE=' "$APP_DIR/.env" | tail -1 | cut -d= -f2-) (set NEXUS_MODE=live in .env when you are ready).
EOF
}

# Put the current deploy/termux/nexus in place of the installed command.
# Written to a temp file and renamed, so the running script is never overwritten.
install_command() {
  local prefix target tmp
  prefix="${PREFIX:-/data/data/com.termux/files/usr}"
  target="$prefix/bin/nexus"
  tmp="$prefix/bin/.nexus.new.$$"
  if cp "$APP_DIR/deploy/termux/nexus" "$tmp" 2>/dev/null && chmod 755 "$tmp" && mv -f "$tmp" "$target"; then
    echo "  $(c '32' '✓') nexus command refreshed"
  else
    rm -f "$tmp"
    echo "  $(c '33' '!') could not refresh the nexus command. Run once: cp ~/nexus-wa/deploy/termux/nexus \$PREFIX/bin/nexus"
  fi
}

# Why the bot is stopped, from the stop file (empty file = a manual `nexus stop`).
stop_reason() {
  local why
  why=$(head -1 "$STOPFILE" 2>/dev/null)
  if [ -n "$why" ]; then printf '%s' "$why"; else printf 'stopped on purpose (nexus stop)'; fi
}

# nexus ensure — start the bot only if it should be running and is not.
# The boot hook and the watchdog both call this. A deliberate `nexus stop` wins.
# A bot can stay alive while doing nothing useful: its event loop is stuck, or
# its socket never recovered after a network drop. The bot writes a heartbeat
# every 30s. If that is more than 5 minutes old, or a linked bot has been
# offline for 20 minutes, kill it and let the supervisor start it again.
heartbeat_check() {
  local now ts state since bot reason=""
  [ -f "$HEARTBEAT" ] || return 0
  now=$(date +%s)
  ts=$(sed -n 's/^ts=//p' "$HEARTBEAT" 2>/dev/null)
  state=$(sed -n 's/^state=//p' "$HEARTBEAT" 2>/dev/null)
  since=$(sed -n 's/^state_since=//p' "$HEARTBEAT" 2>/dev/null)
  if [ -z "$ts" ] || [ $(( now - ts )) -gt 300 ]; then
    reason="heartbeat stale ($(( now - ${ts:-0} ))s)"
  elif [ "$state" != "open" ] && [ -n "$(linked_number)" ] && [ $(( now - ${since:-now} )) -gt 1200 ]; then
    reason="offline for $(( (now - since) / 60 )) min (state=$state)"
  fi
  [ -n "$reason" ] || return 0
  bot=$(cat "$BOTPIDFILE" 2>/dev/null)
  echo "$(date '+%F %T') watchdog: restarting bot — $reason" >>"$LOG"
  if [ -n "$bot" ] && kill -0 "$bot" 2>/dev/null; then
    kill -TERM "$bot" 2>/dev/null
    sleep 5
    kill -0 "$bot" 2>/dev/null && kill -KILL "$bot" 2>/dev/null
  fi
  rm -f "$HEARTBEAT"
}

ensure() {
  if [ -f "$STOPFILE" ]; then
    echo "stopped — $(stop_reason). Start it with: nexus start"
    return 0
  fi
  # One check at a time (boot and the watchdog can fire together). A lock left
  # behind by a killed process is cleared after five minutes.
  local lock="$DATA_DIR/ensure.lock" rc=0
  if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +5 2>/dev/null)" ]; then
    rmdir "$lock" 2>/dev/null
  fi
  mkdir "$lock" 2>/dev/null || { echo "another check is already running"; return 0; }
  if running_pid >/dev/null; then
    heartbeat_check
    echo "running"
  else
    echo "$(date '+%F %T') ensure: not running, starting" >>"$LOG"
    # In a subshell: start() may exit on failure, and the lock must still be released.
    (start) || rc=$?
  fi
  rmdir "$lock" 2>/dev/null
  return "$rc"
}

# Make the watchdog script executable and (re)schedule it with Android's job
# scheduler. Same job id each time, so this replaces the old job, never duplicates.
# Android's minimum period is 15 minutes. The job survives reboots.
schedule_watchdog() {
  command -v termux-job-scheduler >/dev/null 2>&1 || return 1
  [ -f "$WATCHDOG_SCRIPT" ] || return 1
  chmod 755 "$WATCHDOG_SCRIPT" 2>/dev/null
  allow_external_apps
  timeout 20 termux-job-scheduler \
    --script "$WATCHDOG_SCRIPT" \
    --job-id "$WATCHDOG_JOB" \
    --period-ms 900000 \
    --persisted true \
    --network any \
    --battery-not-low false \
    --storage-not-low false \
    --charging false
}

# Lets MacroDroid (or any app granted Termux's RUN_COMMAND permission) start the
# watchdog even when Termux itself is gone. Termux refuses such calls by default.
allow_external_apps() {
  local f="$HOME/.termux/termux.properties"
  mkdir -p "$HOME/.termux"
  grep -qE '^[[:space:]]*allow-external-apps[[:space:]]*=[[:space:]]*true' "$f" 2>/dev/null && return 0
  [ -f "$f" ] && sed -i -E '/^[[:space:]]*#?[[:space:]]*allow-external-apps[[:space:]]*=/d' "$f"
  printf 'allow-external-apps=true\n' >>"$f"
  command -v termux-reload-settings >/dev/null 2>&1 && termux-reload-settings >/dev/null 2>&1
  return 0
}

# nexus watchdog on|off|status
watchdog() {
  case "${1:-status}" in
    on)
      if schedule_watchdog; then
        echo "$(c '32' '✓') watchdog on: every 15 minutes it checks the bot and starts it if it is down"
        echo "  (survives reboots; allow-external-apps=true is set in ~/.termux/termux.properties)"
      else
        echo "$(c '31' '✗') could not schedule the watchdog. Install the Termux:API app, then run: nexus watchdog on"
        echo "  (check it with: nexus doctor)"
        return 1
      fi ;;
    off)
      timeout 20 termux-job-scheduler --cancel --job-id "$WATCHDOG_JOB" >/dev/null 2>&1
      echo "$(c '33' '·') watchdog off. The bot will no longer be restarted automatically if it stops." ;;
    status)
      if [ -f "$DATA_DIR/watchdog.last" ]; then
        echo "  watchdog last ran: $(cat "$DATA_DIR/watchdog.last")"
      else
        echo "  watchdog has not run yet"
      fi ;;
    *) echo "usage: nexus watchdog on|off|status"; return 1 ;;
  esac
}

# nexus doctor — the checks that matter after an outage or a reboot.
doctor() {
  local ok bad warn last bootlog
  ok="$(c '32' '✓')"; bad="$(c '31' '✗')"; warn="$(c '33' '!')"
  echo "nexus doctor"

  if [ -f "$HOME/.termux/boot/nexus-wa.sh" ]; then
    echo "$ok boot hook installed (~/.termux/boot/nexus-wa.sh)"
  else
    echo "$bad boot hook missing. Restart after a power cut will not start the bot. Fix: install -m 755 ~/nexus-wa/deploy/termux/boot-start.sh ~/.termux/boot/nexus-wa.sh"
  fi
  bootlog="$LOG_DIR/boot.log"
  if [ -f "$bootlog" ]; then
    echo "$ok boot hook last ran: $(grep -a 'boot script ran at' "$bootlog" | tail -1 | sed 's/boot script ran at //')"
  else
    echo "$warn boot hook has never run. Install the Termux:Boot app from F-Droid, open it once, and allow autostart."
  fi

  if running_pid >/dev/null; then
    echo "$ok bot is running now (pid $(running_pid))"
  else
    echo "$bad bot is not running now"
  fi
  [ -f "$STOPFILE" ] && echo "$warn $(stop_reason). Nothing restarts it until: nexus start"
  if [ -f "$HEARTBEAT" ]; then
    hb_ts=$(sed -n 's/^ts=//p' "$HEARTBEAT" 2>/dev/null); hb_state=$(sed -n 's/^state=//p' "$HEARTBEAT" 2>/dev/null)
    if [ -n "$hb_ts" ] && [ $(( $(date +%s) - hb_ts )) -le 300 ]; then
      echo "$ok bot heartbeat fresh (link: ${hb_state:-unknown})"
    else
      echo "$warn bot heartbeat is stale — the watchdog will restart the bot on its next check"
    fi
    hb_halted=$(sed -n 's/^queue_halted=//p' "$HEARTBEAT" 2>/dev/null)
    if [ -n "$hb_halted" ] && [ "$hb_halted" != "no" ]; then
      echo "$warn replies are halted by the bot's safety stop ($hb_halted). Restart clears it: nexus restart"
    fi
  fi

  last=$(grep -a '^===== exited' "$LOG" 2>/dev/null | tail -1)
  [ -n "$last" ] && echo "· last bot exit: $last"
  grep -aq 'will not restart by itself' "$LOG" 2>/dev/null \
    && echo "$bad the bot stopped itself (session taken over or unlinked). Read: nexus logs. Then: nexus start, or nexus pair if it was unlinked"

  if [ -f "$DATA_DIR/watchdog.last" ]; then
    echo "$ok watchdog last ran: $(cat "$DATA_DIR/watchdog.last")"
  else
    echo "$warn watchdog has not run yet. Install the Termux:API app, then: nexus watchdog on"
  fi
  if command -v termux-job-scheduler >/dev/null 2>&1; then
    echo "$ok Termux:API job scheduler present"
  else
    echo "$bad Termux:API missing: install the Termux:API app and: pkg install termux-api"
  fi

  if grep -qE '^[[:space:]]*allow-external-apps[[:space:]]*=[[:space:]]*true' "$HOME/.termux/termux.properties" 2>/dev/null; then
    echo "$ok allow-external-apps=true (MacroDroid can start the watchdog)"
  else
    echo "$warn allow-external-apps not set. It is set by: nexus watchdog on"
  fi

  echo ""
  echo "Phone settings only you can change (Android hides these from Termux):"
  echo "  · Settings → Apps → Termux, Termux:Boot, Termux:API → Battery → Unrestricted"
  echo "  · Settings → Wi-Fi → Advanced → Keep Wi-Fi on during sleep → Always"
  echo "  · Termux notification → keep it; run 'termux-wake-lock' once (nexus start does this)"
  echo "  · Run 'bash ~/nexus-wa/deploy/termux/harden.sh' after every reboot if you use Shizuku"
}


# nexus update
# Fetches the latest code from the branch's GitHub upstream, installs dependencies,
# refreshes the nexus command, and restarts the bot if it was running.
# Changes nothing if the checkout has local edits or local commits.
update_app() {
  [ -d "$APP_DIR/.git" ] || { echo "$(c '31' '✗') $APP_DIR is not a git checkout — reinstall with setup.sh"; exit 1; }
  cd "$APP_DIR" || exit 1

  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "$(c '31' '✗') $APP_DIR has local changes. Nothing was changed."
    echo "  review them with: cd ~/nexus-wa && git status"
    exit 1
  fi

  local upstream
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) \
    || { echo "$(c '31' '✗') this branch has no GitHub upstream configured"; exit 1; }

  echo "$(c '33' '·') checking GitHub ($upstream)"
  git fetch --prune --quiet || { echo "$(c '31' '✗') could not reach GitHub — check the phone's connection"; exit 1; }

  local counts ahead behind current latest
  counts=$(git rev-list --left-right --count 'HEAD...@{u}') \
    || { echo "$(c '31' '✗') could not compare with GitHub"; exit 1; }
  read -r ahead behind <<<"$counts"
  current=$(git rev-parse --short HEAD)
  latest=$(git rev-parse --short '@{u}')

  if [ "$ahead" -gt 0 ]; then
    echo "$(c '31' '✗') this branch has commits that are not on GitHub. Update stopped; nothing was changed."
    exit 1
  fi
  if [ "$behind" -eq 0 ]; then
    echo "$(c '32' '✓') already on the latest version ($current). Nothing to do."
    exit 0
  fi

  echo "$(c '33' '·') updating $current → $latest ($behind new commit(s))"
  git pull --ff-only --quiet || { echo "$(c '31' '✗') fast-forward failed. Nothing was reset."; exit 1; }

  echo "$(c '33' '·') installing dependencies (this can take a few minutes)"
  npm ci --omit=optional --no-audit --fund=false --loglevel=error \
    || { echo "$(c '31' '✗') dependency install failed. The bot was NOT restarted."; exit 1; }

  install_command
  echo "$(c '32' '✓') updated to $(git rev-parse --short HEAD)"

  if running_pid >/dev/null; then
    echo "$(c '33' '·') restarting the bot"
    stop >/dev/null 2>&1
    start
  else
    echo "  the bot was not running. Start it with: nexus start"
  fi
}

# Lower-case the command so "Restart" from a Tasker/MacroDroid argument works too.
case "$(printf %s "${1:-}" | tr A-Z a-z)" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  update)  update_app ;;
  ensure)  ensure ;;
  doctor)  doctor ;;
  watchdog) watchdog "${2:-status}" ;;
  status)  status ;;
  logs)    logs ;;
  pair)
    case "${2:-}" in
      remove) pair_remove "${@:3}" ;;
      *)      pair_link "${@:2}" ;;
    esac ;;
  harden)  exec bash "$APP_DIR/deploy/termux/harden.sh" "${2:-}" ;;
  *)
    cat <<EOF
nexus — control Nexus-WA on this phone

  nexus start     start in the background
  nexus stop      stop
  nexus restart   restart
  nexus update    get the latest version from GitHub, install it, restart
  nexus doctor    why it may not be running after an outage or reboot
  nexus watchdog on|off|status   check every 15 min and start the bot if down
  nexus status    running? linked? memory? battery?
  nexus logs      follow the log
  nexus pair [number]   link a WhatsApp account (asks for the number)
  nexus pair remove     delete everything about previous pairs
  nexus harden    stop Android killing the bot (needs Shizuku)
  nexus harden --check   report what is in place, change nothing
EOF
    ;;
esac
