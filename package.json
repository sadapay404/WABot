{
  "name": "nexus-wa",
  "version": "0.2.0",
  "private": true,
  "description": "Nexus-WA \u2014 modular 24/7 personal WhatsApp assistant & automation tool with a Telegram control panel and web dashboard",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "preview": "node --disable-warning=ExperimentalWarning src/index.js --dry-run",
    "pair": "node --disable-warning=ExperimentalWarning src/index.js --pairing",
    "qr": "node --disable-warning=ExperimentalWarning src/index.js --qr",
    "plugins": "node --disable-warning=ExperimentalWarning src/index.js --list-plugins",
    "test": "node --test \"test/**/*.test.js\"",
    "dashboard": "node --disable-warning=ExperimentalWarning src/index.js --dry-run --serve"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^18.0.5",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.13.14",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.33.5"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "telegram",
    "automation",
    "assistant",
    "plugins",
    "dashboard"
  ],
  "license": "MIT"
}
